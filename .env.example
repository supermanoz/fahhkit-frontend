# Copy to .env (dev) / .env.production and fill in. Never commit real secrets.

# Backend API
VITE_API_BASE_URL=https://example.com/api
VITE_FILE_BASE_URL=https://example.com/

# Public website base URL - the ONE place "open the website" buttons point
# (Edit Profile, Shop/Buy Fahhcoin, Terms, ...), always via getSiteUrl(path)
# in src/utils/siteUrl.js.
#  - Native Android/iOS app: this value is used (window.location.origin there
#    is Capacitor's bundled WebView, never a real URL). Falls back to
#    https://fahhkit.netlify.app if unset.
#  - Web: each deployment links to ITSELF (window.location.origin), so netlify
#    stays on netlify and vercel stays on vercel. This var is ignored on web
#    because .env.production is baked into every web build too.
VITE_SITE_URL=https://fahhkit.netlify.app

# Google / Apple sign-in client ids
VITE_GOOGLE_CLIENT_ID=
# VITE_APPLE_CLIENT_ID=

# iOS: enable the external Fahhcoin shop link (Apple 3.1.1). Default false.
# Must be off (or replaced by In-App Purchase) for the PUBLIC App Store release.
# VITE_IOS_EXTERNAL_SHOP=true

# iOS: native Sign in with Apple (set in .env.production for Release/TestFlight only).
# VITE_IOS_APPLE_SIGNIN=true

# ---- Map + routing providers (all optional; defaults = today's behaviour) ----
# Everything below is read in ONE place: src/config/mapProvider.js. Leave it all
# unset to keep OpenFreeMap (basemap) + the public OSRM demo (route snapping).
# NOTE: these values ship inside the app bundle - use a key restricted to your
# domain / bundle id, never a secret key.
#
# Basemap provider name. 'openfreemap' (default) or 'custom'. The map credits
# shown in the map "i" button, Settings and the share image follow the provider
# (OpenFreeMap: OpenStreetMap + OpenMapTiles + OpenFreeMap).
# VITE_MAP_PROVIDER=openfreemap
# Style URL (style.json). {style} is replaced by positron / liberty / bright for
# the 3 map styles in Settings; without {style} the picker has one style.
# VITE_MAP_STYLE_URL=https://tiles.openfreemap.org/styles/{style}
# Optional API key, appended as ?key=... to the style URL and to every request
# (tiles, sprites, glyphs) to the style's host. Param name defaults to 'key'.
# VITE_MAP_API_KEY=
# VITE_MAP_API_KEY_PARAM=key
# Credits for a 'custom' provider: "Label|https://link, Label2|https://link2".
# OpenStreetMap is always credited as well.
# VITE_MAP_ATTRIBUTION=© ExampleMaps|https://example.com/credits
# Raster tiles for the small run-summary map (default: OpenStreetMap's).
# VITE_MAP_RASTER_URL=https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png
#
# Route snapping (drawing a route on roads). 'osrm' (default) or 'none' (no
# snapping - taps are joined with straight lines). If the service is down or
# slow the app also falls back to straight lines on its own.
# VITE_ROUTING_PROVIDER=osrm
# OSRM-compatible base URL, ending in /route/v1 (default: the public demo
# server - shared, no uptime guarantee; self-host for production).
# VITE_ROUTING_URL=https://router.project-osrm.org/route/v1
# VITE_ROUTING_API_KEY=
# VITE_ROUTING_API_KEY_PARAM=key
