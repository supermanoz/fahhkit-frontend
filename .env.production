VITE_API_BASE_URL=https://cafebizarre.com.np/fahhkit

# .env (dev) sets a -test fallback API; Vite merges .env into production builds
# too, so blank it here or it would be baked into the release bundle.
VITE_API_FALLBACK_URL=
VITE_FILE_BASE_URL=https://cafebizarre.com.np/

# Where /shop (the public Fahhcoin storefront) lives for the NATIVE
# Android/iOS app only - see utils/siteUrl.js. On the web every site uses its
# own window.location.origin and ignores this. Needed here because this is
# the env file npm run build:app/cap:sync reads, and inside the native shell
# window.location.origin is Capacitor's bundled-WebView origin, never a real
# public URL.
VITE_SITE_URL=https://fahhkit.netlify.app

# iOS only: let the "Continue to Shop" (Buy Fahhcoin) button open the web shop
# (VITE_SITE_URL/shop) in the system browser. Default/unset = blocked, because
# Apple App Store Guideline 3.1.1 forbids linking out to an external purchase
# flow for a virtual currency. MUST be set to false/removed (or replaced by
# real In-App Purchase) before the PUBLIC App Store release - see
# utils/siteUrl.js's iosShopRedirectBlocked.
VITE_IOS_EXTERNAL_SHOP=true

# Google sign-in (web OAuth client id - must match google.oauth.client.ids on the backend)
VITE_GOOGLE_CLIENT_ID=797208432008-o19nbtt7bst014jm3i8efn9gv81n4prd.apps.googleusercontent.com

# Apple sign-in (Services ID identifier - must match apple.oauth.client.ids on the backend).
# AppleSignInButton renders nothing until this is set, same as Google above.
# VITE_APPLE_CLIENT_ID=

# Native Google sign-in on iOS (needs the iOS OAuth client: iosClientId in
# capacitor.config.json + the REVERSED_CLIENT_ID URL scheme in Info.plist).
VITE_IOS_GOOGLE=true

# Native Sign in with Apple on iOS (Release / TestFlight build only - this is
# .env.production, so `npm run ios:dev` and the dev server never read it).
# Needs the Sign in with Apple capability + apple.oauth.client.ids on the backend.
VITE_IOS_APPLE_SIGNIN=true
