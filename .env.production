VITE_API_BASE_URL=https://cafebizarre.com.np/fahhkit-test
VITE_FILE_BASE_URL=https://cafebizarre.com.np/

# Where /shop (the public Fahhcoin storefront) actually lives - see
# utils/siteUrl.js. Required here (not just a nice-to-have) because this is
# the env file npm run build:app/cap:sync also reads, and inside the
# native Android/iOS shell window.location.origin resolves to Capacitor's
# own bundled-WebView origin, never a real public URL.
VITE_SITE_URL=https://cafebizarre.com.np

# Apple App Store Guideline 3.1.1 - an app can't link out to an external
# purchase flow for a virtual currency like Fahhcoin without risking
# rejection. Off (unset) until real Apple In-App Purchase exists for
# Fahhcoin; see utils/siteUrl.js's iosShopRedirectBlocked.
# VITE_IOS_IAP=true

# Google sign-in (web OAuth client id - must match google.oauth.client.ids on the backend)
VITE_GOOGLE_CLIENT_ID=797208432008-o19nbtt7bst014jm3i8efn9gv81n4prd.apps.googleusercontent.com

# Apple sign-in (Services ID identifier - must match apple.oauth.client.ids on the backend).
# AppleSignInButton renders nothing until this is set, same as Google above.
# VITE_APPLE_CLIENT_ID=
