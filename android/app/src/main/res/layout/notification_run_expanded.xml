<?xml version="1.0" encoding="utf-8"?>
<!-- Expanded state of the persistent run-tracking notification. Same content
     as notification_run_collapsed.xml, larger. v1 has no action buttons (tap
     anywhere to return to the app) - Pause/Resume/End are a planned
     fast-follow once this base notification is confirmed working on-device;
     they'd go in a button row appended below the stats here. -->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <TextView
        android:id="@+id/run_notif_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/run_notification_header_running"
        android:gravity="center"
        android:paddingTop="12dp"
        android:paddingBottom="12dp"
        android:text="Running"
        android:textColor="#FFFFFF"
        android:textSize="16sp"
        android:textStyle="bold" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/run_notification_body_bg"
        android:baselineAligned="false"
        android:orientation="horizontal"
        android:paddingTop="16dp"
        android:paddingBottom="16dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">
            <TextView
                android:id="@+id/run_notif_value_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/passion_one_bold"
                android:text="0:00"
                android:textColor="@color/runNotifValue"
                android:textSize="22sp"
                android:textStyle="bold" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Time"
                android:textColor="@color/runNotifLabel"
                android:textSize="11sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">
            <TextView
                android:id="@+id/run_notif_value_pace"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/passion_one_bold"
                android:text="--"
                android:textColor="@color/runNotifValue"
                android:textSize="22sp"
                android:textStyle="bold" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Avg. pace (/km)"
                android:textColor="@color/runNotifLabel"
                android:textSize="11sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">
            <TextView
                android:id="@+id/run_notif_value_distance"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/passion_one_bold"
                android:text="0.00"
                android:textColor="@color/runNotifValue"
                android:textSize="22sp"
                android:textStyle="bold" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Distance (km)"
                android:textColor="@color/runNotifLabel"
                android:textSize="11sp" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
