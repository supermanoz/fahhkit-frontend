<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- "development" here; Xcode's automatic signing switches this to "production" when the
	     app is archived/distributed (TestFlight / App Store) using the distribution profile. -->
	<key>aps-environment</key>
	<string>development</string>
	<!-- Sign in with Apple: paid team only. Dev-FreeTeam has no entitlements file, so it is
	     absent there; also enable the capability on the App ID in the Developer portal. -->
	<key>com.apple.developer.applesignin</key>
	<array>
		<string>Default</string>
	</array>
</dict>
</plist>
