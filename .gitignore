# iOS push (FCM): GoogleService-Info.plist is not in the repo yet. Download it from the Firebase
# console (iOS app, bundle id must match the Xcode target) into ios/App/App/ and add it to the
# App target in Xcode. Unlike Android's google-services.json it is safe to commit if you prefer;
# uncomment to keep it local instead:
# ios/App/App/GoogleService-Info.plist

# Signed APK/AAB output of the Android release (never commit)
/release/

