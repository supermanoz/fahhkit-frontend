{
  "name": "frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "preview": "vite preview",
    "predeploy": "GH_PAGES=true npm run build",
    "deploy": "gh-pages -d dist",
    "prepare": "husky",
    "build:app": "VITE_APP_SHELL=true vite build --outDir dist-app",
    "cap:sync": "npm run build:app && npx cap sync",
    "android:open": "npm run cap:sync && npx cap open android",
    "ios:open": "npm run cap:sync && npx cap open ios",
    "android:dev": "npx cap run android -l --host=$HOST_IP",
    "ios:dev": "npx cap run ios -l --host=$HOST_IP",
    "android:debug": "npm run cap:sync && cd android && ./gradlew assembleDebug",
    "android:release": "npm run cap:sync && cd android && ./gradlew bundleRelease"
  },
  "lint-staged": {
    "*.{js,jsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{css,json,md}": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "@capacitor-community/background-geolocation": "1.3.1",
    "@capacitor-community/keep-awake": "^5.0.0",
    "@capacitor/android": "^6.2.2",
    "@capacitor/app": "6.0.2",
    "@capacitor/browser": "6.0.6",
    "@capacitor/core": "^6.2.2",
    "@capacitor/geolocation": "^6.0.2",
    "@capacitor/haptics": "^6.0.2",
    "@capacitor/ios": "^6.2.2",
    "@capacitor/local-notifications": "6.1.3",
    "@capacitor/splash-screen": "^6.0.4",
    "@capacitor/status-bar": "^6.0.2",
    "@codetrix-studio/capacitor-google-auth": "3.3.6",
    "@fontsource/fredoka": "^5.3.0",
    "@fontsource/noto-sans-devanagari": "^5.3.0",
    "@fontsource/nunito": "^5.3.0",
    "@maplibre/maplibre-gl-leaflet": "^0.1.4",
    "@stomp/stompjs": "^7.3.0",
    "animejs": "^4.5.0",
    "aos": "^2.3.4",
    "framer-motion": "^13.1.1",
    "leaflet": "^1.9.4",
    "maplibre-gl": "^6.9.0",
    "polygon-clipping": "^0.15.7",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-icons": "^5.3.0",
    "react-leaflet": "^4.2.1",
    "react-router-dom": "^6.30.4",
    "recharts": "^3.10.1"
  },
  "devDependencies": {
    "@capacitor/assets": "3.0.5",
    "@capacitor/cli": "^6.2.2",
    "@eslint/js": "^9.13.0",
    "@playwright/test": "^1.49.0",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-basic-ssl": "^2.3.0",
    "@vitejs/plugin-react": "^4.3.3",
    "eslint": "^9.13.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react": "^7.37.2",
    "eslint-plugin-react-hooks": "^5.0.0",
    "eslint-plugin-react-refresh": "^0.4.14",
    "globals": "^15.11.0",
    "husky": "^9.1.7",
    "jsdom": "^25.0.1",
    "lint-staged": "^15.5.2",
    "prettier": "^3.9.6",
    "sharp": "^0.32.6",
    "vite": "^6.0.0",
    "vitest": "^2.1.9"
  }
}
